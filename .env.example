# ==============================================================================
# Lang - Tampemawa Family Tree & Heritage Archive
# Firebase Firestore + Cloudinary Configuration
# ==============================================================================

# 1. Google Firebase Firestore (Free Spark Plan)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: set if you created a named Firestore database instead of "(default)"
# NEXT_PUBLIC_FIREBASE_DATABASE_ID=

# 2. Cloudinary Image Storage (Free Tier: 25 credits/month)
# Get these from https://console.cloudinary.com -> Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or alternatively use a single CLOUDINARY_URL:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
