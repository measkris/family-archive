# ==============================================================================
# Family Archive — Firebase Firestore + Cloudinary Configuration
# ==============================================================================

# 1. Google Firebase Firestore (Free Spark Plan — Server-Side Only)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Optional: set if you created a named Firestore database instead of "(default)"
# FIREBASE_DATABASE_ID=
# Optional: comma-separated email(s) or UID(s) granted Super Admin permissions across every tree
# SUPER_ADMIN_EMAIL=admin@yourdomain.com
# SUPER_ADMIN_UID=

# 2. Cloudinary Image Storage (Free Tier: 25 credits/month)
# Get these from https://console.cloudinary.com -> Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
# Or alternatively use a single CLOUDINARY_URL:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
